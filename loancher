      const check = () => {
        if (window.__coasterExpansionBooted && document.getElementById('rc-course-mode-buttons')) return resolve();
        if (Date.now() - startedAt > 20000) return reject(new Error('起動確認に失敗しました。ページを再読み込みしてから再実行してください。'));
        setTimeout(check, 100);
      };
      check();
    });

    window[KEY] = { urls, version: '11.1' };
    const el = document.getElementById('coaster-expansion-launcher-message');
